# Server-only MetaAPI credentials (never use VITE_ prefix)
METAAPI_TOKEN=
# Optional CopyFactory strategy id — only used if the client explicitly sends strategyId.
# Chart Scanner opens trades; connecting MT5 alone will not auto-subscribe / copy trades.
METAAPI_STRATEGY_ID=
METAAPI_REGION=new-york

# Broker search (MT5API /Search) — defaults to http://66.23.225.158
MT5_API_BASE=http://66.23.225.158
# Optional browser/native override (used by src/mt5Api.js)
VITE_MT5_API_BASE=http://66.23.225.158

# Chart Scanner symbol detection (OpenAI Vision) — server only, never VITE_
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Brevo transactional email (license keys to clients) — server only
# 1) https://app.brevo.com → SMTP & API → API keys → Create a new API key
# 2) Senders → add/verify BREVO_SENDER_EMAIL (domain or single address)
# 3) Add these on Vercel → Project → Settings → Environment Variables
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@apex-ea.com
BREVO_SENDER_NAME=ApexEA
# Optional
BREVO_REPLY_TO=
PUBLIC_APP_URL=https://www.apex-ea.com

# PayPal (same account for app access + Zetascalperai.com robot sales)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
# Developer Dashboard → Webhooks → URL https://www.apex-ea.com/api/paypal/webhook
# Events: PAYMENT.CAPTURE.COMPLETED
PAYPAL_WEBHOOK_ID=

# Auto license for website robot purchases
# Orders API checkout must be USD (this PayPal app rejects ZAR).
ROBOT_PURCHASE_PRICE=82.50
ROBOT_PURCHASE_CURRENCY=USD
# zetascalperai.com NCP payment links still charge R1500 — webhook matches both.
ROBOT_NCP_PRICE=1500.00
ROBOT_NCP_CURRENCY=ZAR
ROBOT_BOT_ID=zeta-scalper-ai-mtyew2ps
ROBOT_BOT_NAME=ZETA SCALPER AI
ROBOT_MENTOR_EMAIL=trapgoatkaymow@gmail.com
# PayPal NCP link ids used by the marketing site "Pay with PayPal" buttons
ROBOT_NCP_LINK_IDS=Q398DPLVNQS56,VTE7JTFTM7CT8
